diff --git a/Assets/Game/Scripts/JourneyGraphicsSettings.cs b/Assets/Game/Scripts/JourneyGraphicsSettings.cs
index 5e23c32..f4cb3d1 100644
--- a/Assets/Game/Scripts/JourneyGraphicsSettings.cs
+++ b/Assets/Game/Scripts/JourneyGraphicsSettings.cs
@@ -4,6 +4,7 @@ using UnityEngine;
 using UnityEngine.Rendering;
