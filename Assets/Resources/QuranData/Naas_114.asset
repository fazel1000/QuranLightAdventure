  m_EditorClassIdentifier: ''
  m_Name: Naas_114
  surahNumber: 114
  verses:
  - verseNumber: 1
    verseAudio:
      fileID: 8300000
      guid: 98d8c1f688156ce41945d7cb22d0614e
      type: 3
    displayText: بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
    persianTranslation: به نام خداوند بخشندهٔ مهربان
    englishTranslation: In the name of Allah, the Most Merciful, the Ever Merciful.
  - verseNumber: 2
    verseAudio:
      fileID: 0
    displayText: قُلْ أَعُوذُ بِرَبِّ النَّاسِ
    persianTranslation: 'بگو: به پروردگار مردم پناه می‌برم.'
    englishTranslation: 'Say: I seek refuge in the Lord of humankind.'
  - verseNumber: 3
    verseAudio:
      fileID: 0
    displayText: مَلِكِ النَّاسِ
    persianTranslation: فرمانروای مردم.
    englishTranslation: The King of humankind.
  - verseNumber: 4
    verseAudio:
      fileID: 0
    displayText: إِلَٰهِ النَّاسِ
    persianTranslation: خدای مردم.
    englishTranslation: The God of humankind.
  - verseNumber: 5
    verseAudio:
      fileID: 0
    displayText: مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ
    persianTranslation: از شرّ وسوسه‌گرِ پنهان‌شونده.
    englishTranslation: From the evil of the whisperer who retreats.
  - verseNumber: 6
    verseAudio:
      fileID: 0
    displayText: الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ
    persianTranslation: آن‌که در سینه‌های مردم وسوسه می‌کند.
    englishTranslation: Who whispers into the hearts of humankind.
  - verseNumber: 7
    verseAudio:
      fileID: 0
    displayText: مِنَ الْجِنَّةِ وَالنَّاسِ
    persianTranslation: از جنّیان و آدمیان.
    englishTranslation: From among jinn and humankind.
